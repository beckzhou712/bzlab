---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getColumns } from "@/utils/getColumns";
import { useTranslations } from "@/i18n";
import { tplStr } from "@/i18n/format";
import config from "@/config";

const columns = await getColumns();

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout
  title={`${t.pages.columnsTitle} | ${config.site.title}`}
  description={t.pages.columnsDesc}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.columnsTitle} pageDesc={t.pages.columnsDesc}>
    <ul>
      {
        columns.map(column => (
          <li class="my-6">
            <a
              href={getRelativeLocaleUrl(locale, `columns/${column.slug}`)}
              class:list={[
                "text-accent inline-block text-lg font-medium",
                "decoration-dashed underline-offset-4 hover:underline",
                "focus-visible:no-underline focus-visible:underline-offset-0",
              ]}
            >
              <h2>{column.title}</h2>
            </a>
            <p class="text-sm opacity-80">
              {
                column.posts.length === 1
                  ? t.pages.columnPostCountOne
                  : tplStr(t.pages.columnPostCount, {
                      count: column.posts.length,
                    })
              }
            </p>
            {column.description && <p>{column.description}</p>}
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
